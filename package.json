{
  "name": "@stacksjs/calendar",
  "version": "0.0.1",
  "description": "Dependency-free add-to-calendar links and RFC 5545 event generation",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "bun --bun build.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:types": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun pickier . --config .config/pickier.ts",
    "lint:fix": "bunx --bun pickier . --config .config/pickier.ts --fix",
    "release:patch": "bunx --bun bumpx patch --commit --tag --push --yes"
  },
  "devDependencies": {
    "better-dx": "^0.2.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/calendar.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/calendar/issues"
  },
  "keywords": [
    "calendar",
    "ical",
    "ics",
    "google-calendar",
    "outlook",
    "yahoo-calendar"
  ],
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
